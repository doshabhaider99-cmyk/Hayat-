# GEMINI_API_KEY: Required for Gemini AI API calls.
# In AI Studio, this is injected automatically at runtime.
# On Vercel: Set this in Project Settings > Environment Variables > GEMINI_API_KEY
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# In AI Studio: injected at runtime.
# On Vercel: https://your-project.vercel.app
APP_URL="MY_APP_URL"

